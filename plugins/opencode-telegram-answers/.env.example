# ── Credenciales reales de Telegram ─────────────────────────────────────
# Copia este archivo a `.env` (en el directorio del proyecto o en
# `~/.config/opencode/.env` para que aplique a TODAS tus sesiones).
#
# NUNCA subas tu `.env` real a git ni lo compartas: contiene el token
# del bot, que da control total sobre los mensajes.

# 1. Crea un bot con @BotFather en Telegram y copia su token:
TELEGRAM_BOT_TOKEN=123456789:AAAaabbb...reemplaza-con-tu-token

# 2. Añade el bot al chat/grupo/canal y consigue el chat_id:
#    curl "https://api.telegram.org/bot<TU_TOKEN>/getUpdates"
#    El chat_id aparece en el JSON; los grupos suelen ser negativos (-100...)
TELEGRAM_CHAT_ID=-1001234567890