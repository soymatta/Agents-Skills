---
import Layout from '../layouts/Layout.astro';

const agents = [
	{
		name: "vault",
		description: "Unified notes manager for Obsidian, OneNote, Notion, and any markdown-based app. Index, search, organize, verify, create notes, run health checks, and detect broken links — all in one agent with bilingual support (EN/ES).",
		permissions: "read, glob, grep, task, edit",
		type: "agent" as const,
	},
	{
		name: "paper-researcher",
		description: "Produces rigorous academic papers in Markdown (APA/IEEE/Vancouver). Bilingual EN/ES.",
		permissions: "bash, read, glob, grep, webfetch, task, edit",
		type: "agent" as const,
	},
	{
		name: "jobfinder",
		description: "Analyzes professional profile, searches jobs across multiple boards, calculates 5D match scores, generates CVs and cover letters, and tracks applications.",
		permissions: "bash, read, glob, grep, webfetch, task, edit",
		type: "agent" as const,
	},
	{
		name: "constructor",
		description: "Default full-access build agent. Reads, writes, edits files, runs commands, and executes all available tools. Combines the build role with self-improvement, skill creation, goal optimization, and roadmap tracking.",
		permissions: "* allow (question, plan_enter; doom_loop ask)",
		type: "agent" as const,
	},
	{
		name: "planner",
		description: "Read-only plan agent for analysis and code exploration. Cannot modify files — ideal for planning changes, analyzing unfamiliar codebases, and proposing approaches before any code is written.",
		permissions: "read, glob, grep, bash (edit denied — plans only)",
		type: "agent" as const,
	},
];

const skills = [
	{
		name: "telegram-notify",
		description: "Full Telegram Bot API client (sends text, photos, documents, media groups; webhooks, polling) with auto-retry and exponential backoff. Never blocks execution on failures.",
		usage: "Notify me on Telegram when this completes",
		dependencies: ["requests"],
		category: "notification",
		type: "first-party" as const,
	},
	{
		name: "research-pipeline",
		description: "Structured quantitative research process for prediction markets and data-driven questions.",
		usage: "Research this prediction market question",
		dependencies: ["telegram-notify"],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "backtest-run",
		description: "Runs backtests for trading strategies with slippage/fill modeling and robustness checks.",
		usage: "Backtest this trading strategy",
		dependencies: ["telegram-notify"],
		category: "finance",
		type: "first-party" as const,
	},
	{
		name: "backtest-validate",
		description: "5-dimension scoring framework for backtest quality: Sample Size, Expectancy, Risk Management, Robustness, Execution Realism.",
		usage: "Validate this backtest quality",
		dependencies: ["backtest-run"],
		category: "finance",
		type: "first-party" as const,
	},
	{
		name: "academic-source-search",
		description: "Searches verified scientific sources across 14 academic databases with quality tier filtering.",
		usage: "Find papers about machine learning",
		dependencies: [],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "citation-formatter",
		description: "Complete citation and reference formatting for APA 7th, IEEE, and Vancouver styles.",
		usage: "Format my citations in APA 7th",
		dependencies: [],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "math-notation",
		description: "Math notation rules for inline formulas: italic variables, superscripts, subscripts.",
		usage: "Auto-applied when writing math in academic docs",
		dependencies: ["citation-formatter"],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "content-humanizer",
		description: "Final document revision to reduce AI-detectable patterns. Includes local detection verification script.",
		usage: "Make this text undetectable by AI",
		dependencies: [],
		category: "writing",
		type: "first-party" as const,
	},
	{
		name: "osint",
		description: "OSINT investigation framework with 7 reference guides and 5 scripts for person/company/domain research.",
		usage: "Run an OSINT investigation on this target",
		dependencies: [],
		category: "investigation",
		type: "first-party" as const,
	},
	{
		name: "metric-optimizer",
		description: "Optimizes numerical metrics via autonomous iterative improvement loop. Never asks for input.",
		usage: "Optimize this metric to 95% accuracy",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "roadmaps",
		description: "Creates, updates, and follows adaptive roadmaps for any project. Validates structure and detects cycles.",
		usage: "Create a plan for this project",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "project-analyzer",
		description: "Read-only project analysis: structure, code quality, bugs, security, performance, and dependency health with severity levels.",
		usage: "Analyze this codebase for issues",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "jobfinder",
		description: "Multi-board job search with 5-dimension fit scoring, personalized recommendations, CV PDF generation, application tracking, and interview prep.",
		usage: "Find jobs matching my profile",
		dependencies: [],
		category: "career",
		type: "first-party" as const,
	},
	{
		name: "agent-self-improver",
		description: "Self-improvement framework for agents: collects feedback, detects patterns, suggests improvements with human supervision.",
		usage: "Improve this agent's performance",
		dependencies: [],
		category: "meta",
		type: "first-party" as const,
	},
	{
		name: "skill-creator",
		description: "Meta-skill: create, evaluate, compare, and optimize other skills with benchmarking.",
		usage: "Create a new skill from scratch",
		dependencies: [],
		category: "meta",
		type: "third-party" as const,
		author: "Anthropic, PBC",
		license: "Apache 2.0",
		repo: "https://github.com/anthropics/claude-code",
	},
	{
		name: "impeccable",
		description: "Frontend design audit, polish, and redesign skill with 23 commands for UI excellence.",
		usage: "/init, /shape, /critique, /polish, /audit",
		dependencies: [],
		category: "design",
		type: "third-party" as const,
		author: "pbakaus",
		license: "Apache 2.0",
		repo: "https://github.com/pbakaus/impeccable",
	},
	{
		name: "ai-job-search",
		description: "AI job application framework: 5D fit evaluation, CV tailoring, cover letters, interview prep, and application tracking.",
		usage: "/setup, /apply, /scrape, /rank, /interview",
		dependencies: [],
		category: "career",
		type: "third-party" as const,
		author: "MadsLorentzen",
		license: "MIT",
		repo: "https://github.com/MadsLorentzen/ai-job-search",
	},
];

const aiCommands = [
	{
		skill: "impeccable",
		commands: [
			{ cmd: "/init", desc: "Capture product context in PRODUCT.md" },
			{ cmd: "/shape [feature]", desc: "Plan UX/UI before writing code" },
			{ cmd: "/critique [target]", desc: "UX design review with heuristic scoring" },
			{ cmd: "/audit [target]", desc: "Technical quality checks (a11y, perf, responsive)" },
			{ cmd: "/polish [target]", desc: "Final quality pass before shipping" },
			{ cmd: "/bolder [target]", desc: "Amplify safe or bland designs" },
			{ cmd: "/harden [target]", desc: "Production-ready: errors, i18n, edge cases" },
			{ cmd: "/animate [target]", desc: "Add purposeful animations and motion" },
			{ cmd: "/layout [target]", desc: "Fix spacing, rhythm, and visual hierarchy" },
			{ cmd: "/document", desc: "Generate DESIGN.md from existing code" },
			{ cmd: "/live", desc: "Visual variant mode in the browser" },
		],
	},
	{
		skill: "ai-job-search",
		commands: [
			{ cmd: "/setup", desc: "Onboarding: fill in candidate profile" },
			{ cmd: "/apply <url>", desc: "Full workflow: evaluate fit, draft CV + cover letter" },
			{ cmd: "/scrape", desc: "Search multiple job portals with fit ratings" },
			{ cmd: "/rank", desc: "Batch-score scraped jobs into ranked shortlist" },
			{ cmd: "/interview", desc: "Stage-specific interview prep + mock interview" },
			{ cmd: "/upskill", desc: "Skill gap analysis with learning plans" },
		],
	},
];

const categoryColors: Record<string, string> = {
	notification: "var(--green)",
	research: "var(--cyan)",
	finance: "var(--amber)",
	writing: "var(--purple)",
	investigation: "var(--red)",
	automation: "var(--accent)",
	meta: "var(--text-dim)",
	design: "var(--purple)",
	career: "var(--green)",
};
---

<Layout title="Agents & Skills — AI Agent Definitions">
	<nav class="nav">
		<div class="nav-inner">
			<a href="#" class="nav-logo">
				<span class="logo-icon">&#9670;</span>
				Agents-Skills
			</a>
			<div class="nav-links">
				<a href="#install">Install</a>
				<a href="#skills">Skills</a>
				<a href="#agents">Agents</a>
				<a href="#commands">Commands</a>
				<a href="#third-party">Third-Party</a>
				<a href="https://github.com/soymatta/Agents-Skills" target="_blank">GitHub</a>
			</div>
		</div>
	</nav>

	<header class="hero">
		<div class="hero-badge">Open Source &middot; MIT License</div>
		<h1>AI Agents &amp; Skills</h1>
		<p class="hero-sub">
			A curated collection of agent and skill definitions for
			<strong>OpenCode</strong>, <strong>Claude Code</strong>, <strong>Cursor</strong>,
			and <strong>Windsurf</strong>. Each definition shapes how AI assistants
			approach specific tasks — from vault indexing to backtesting to OSINT investigations.
		</p>
		<div class="hero-actions">
			<a href="#install" class="btn btn-primary">Get Started</a>
			<a href="#skills" class="btn btn-ghost">Browse Skills</a>
		</div>
		<div class="hero-stats">
			<div class="stat">
				<span class="stat-num">{skills.length}</span>
				<span class="stat-label">Skills</span>
			</div>
			<div class="stat">
				<span class="stat-num">{agents.length}</span>
				<span class="stat-label">Agents</span>
			</div>
			<div class="stat">
				<span class="stat-num">{aiCommands.reduce((acc, c) => acc + c.commands.length, 0)}</span>
				<span class="stat-label">Commands</span>
			</div>
			<div class="stat">
				<span class="stat-num">4</span>
				<span class="stat-label">Platforms</span>
			</div>
		</div>
	</header>

	<section id="install" class="section">
		<div class="container">
			<h2>Installation</h2>
			<p class="section-desc">Clone the repo, install dependencies, and run the interactive installer to toggle which agents and skills you want.</p>

			<div class="install-steps">
				<div class="install-step">
					<div class="step-num">1</div>
					<div class="step-content">
						<h3>Clone &amp; Install</h3>
						<pre><code>git clone https://github.com/soymatta/Agents-Skills.git
cd Agents-Skills
pip install -r skills/requirements.txt</code></pre>
					</div>
				</div>
				<div class="install-step">
					<div class="step-num">2</div>
					<div class="step-content">
						<h3>Run the Installer</h3>
						<pre><code>python setup.py</code></pre>
						<p class="step-note">Interactive TUI — toggle agents/skills with arrow keys and space.</p>
					</div>
				</div>
				<div class="install-step">
					<div class="step-num">3</div>
					<div class="step-content">
						<h3>Or Install Everything</h3>
						<pre><code>python setup.py --all
python setup.py --all --platform opencode --local</code></pre>
						<p class="step-note">Supports: opencode, claude, cursor, windsurf</p>
					</div>
				</div>
			</div>

			<div class="install-note">
				<strong>Requirements:</strong> Python &ge; 3.11 &middot;
				<strong>Environment:</strong> Copy <code>.env.example</code> to <code>.env</code> and set <code>TELEGRAM_BOT_TOKEN</code> + <code>TELEGRAM_CHAT_ID</code> for notification skills.
			</div>
		</div>
	</section>

	<section id="skills" class="section section-alt">
		<div class="container">
			<h2>Skills</h2>
			<p class="section-desc">Specialized instructions and workflows for specific tasks. Each skill is a markdown file with YAML frontmatter that defines triggers, permissions, and procedures.</p>

			<div class="skill-grid">
				{skills.filter(s => s.type === "first-party").map(skill => (
					<div class="skill-card">
						<div class="skill-header">
							<h3 class="skill-name">{skill.name}</h3>
							<span class="skill-badge" style={`--badge-color: ${categoryColors[skill.category]}`}>
								{skill.category}
							</span>
						</div>
						<p class="skill-desc">{skill.description}</p>
						{skill.dependencies.length > 0 && (
							<div class="skill-deps">
								<span class="deps-label">Requires:</span>
								{skill.dependencies.map(dep => (
									<code class="dep-tag">{dep}</code>
								))}
							</div>
						)}
						<div class="skill-usage">
							<span class="usage-label">Usage:</span>
							<code class="usage-example">{skill.usage}</code>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="agents" class="section">
		<div class="container">
			<h2>Agents</h2>
			<p class="section-desc">Primary agents with defined permissions that shape how AI assistants behave for specific workflows.</p>

			<div class="agent-grid">
				{agents.map(agent => (
					<div class="agent-card">
						<div class="agent-header">
							<h3 class="agent-name">{agent.name}</h3>
							<span class="agent-badge">agent</span>
						</div>
						<p class="agent-desc">{agent.description}</p>
						<div class="agent-perms">
							<span class="perms-label">Permissions:</span>
							<div class="perm-tags">
								{agent.permissions.split(", ").map(p => (
									<span class="perm-tag">{p}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="commands" class="section section-alt">
		<div class="container">
			<h2>Commands</h2>
			<p class="section-desc">Slash commands you can type directly in your AI assistant. Some skills expose explicit commands for common workflows.</p>

			<div class="commands-grid">
				{aiCommands.map(group => (
					<div class="command-group">
						<div class="command-group-header">
							<h3 class="command-skill-name">{group.skill}</h3>
							<span class="command-count">{group.commands.length} command{group.commands.length > 1 ? 's' : ''}</span>
						</div>
						<div class="command-list">
							{group.commands.map(cmd => (
								<div class="command-item">
									<code class="command-cmd">{cmd.cmd}</code>
									<span class="command-desc">{cmd.desc}</span>
								</div>
							))}
						</div>
					</div>
				))}
			</div>

			<div class="commands-note">
				<strong>Note:</strong> Most skills activate from natural language — no commands needed. Only skills with explicit slash commands are listed here.
			</div>
		</div>
	</section>

	<section id="third-party" class="section">
		<div class="container">
			<h2>Third-Party Skills</h2>
			<p class="section-desc">These skills are authored externally and included with their original licenses. Do not modify them — pull updates from the upstream source.</p>

			<div class="third-party-grid">
				{skills.filter(s => s.type === "third-party").map(skill => (
					<div class="tp-card">
						<div class="tp-header">
							<h3 class="tp-name">{skill.name}</h3>
							<span class="tp-badge">{skill.license}</span>
						</div>
						<p class="tp-desc">{skill.description}</p>
						<div class="tp-meta">
							<span>By <strong>{skill.author}</strong></span>
							<a href={skill.repo} target="_blank" class="tp-link">
								View Source &rarr;
							</a>
						</div>
					</div>
				))}
			</div>

			<div class="tp-rules">
				<h3>Modification Rules</h3>
				<ul>
					<li><code>skill-creator</code> — authored by <strong>Anthropic, PBC</strong> (Apache 2.0). Do not modify. To update, pull from the upstream source.</li>
					<li><code>impeccable</code> — authored by <strong>pbakaus</strong> (Apache 2.0). Do not modify. To update, run <code>npx impeccable install --providers=opencode --scope=project --force</code>.</li>
					<li><code>ai-job-search</code> — authored by <strong>MadsLorentzen</strong> (MIT). Do not modify. To update, pull from the upstream source.</li>
				</ul>
			</div>
		</div>
	</section>

	<footer class="footer">
		<div class="container footer-inner">
			<p>Agents &amp; Skills &middot; <a href="https://github.com/soymatta/Agents-Skills">GitHub</a> &middot; MIT License</p>
			<p class="footer-sub">AI agent and skill definitions for OpenCode, Claude Code, Cursor, and Windsurf.</p>
		</div>
	</footer>
</Layout>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 11, 0.8);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border-subtle);
	}

	.nav-inner {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 0 24px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav-logo {
		font-weight: 700;
		font-size: 1rem;
		color: var(--text);
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.logo-icon {
		color: var(--accent);
		font-size: 1.2em;
	}

	.nav-links {
		display: flex;
		gap: 24px;
		font-size: 0.875rem;
	}

	.nav-links a {
		color: var(--text-muted);
	}

	.nav-links a:hover {
		color: var(--text);
	}

	.hero {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 80px 24px 60px;
		text-align: center;
	}

	.hero-badge {
		display: inline-block;
		padding: 6px 14px;
		border-radius: 999px;
		background: var(--accent-glow);
		border: 1px solid rgba(99, 102, 241, 0.3);
		color: var(--accent-light);
		font-size: 0.8rem;
		font-weight: 500;
		margin-bottom: 24px;
		letter-spacing: 0.02em;
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 20px;
		background: linear-gradient(135deg, var(--text) 0%, var(--text-muted) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-sub {
		font-size: 1.125rem;
		color: var(--text-muted);
		max-width: 640px;
		margin: 0 auto 32px;
		line-height: 1.7;
	}

	.hero-sub strong {
		color: var(--text);
	}

	.hero-actions {
		display: flex;
		gap: 12px;
		justify-content: center;
		margin-bottom: 48px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 12px 24px;
		border-radius: var(--radius-sm);
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.2s;
		cursor: pointer;
	}

	.btn-primary {
		background: var(--accent);
		color: white;
		border: 1px solid var(--accent);
	}

	.btn-primary:hover {
		background: var(--accent-light);
		color: white;
	}

	.btn-ghost {
		background: transparent;
		color: var(--text-muted);
		border: 1px solid var(--border);
	}

	.btn-ghost:hover {
		color: var(--text);
		border-color: var(--text-dim);
	}

	.hero-stats {
		display: flex;
		gap: 48px;
		justify-content: center;
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.stat-num {
		font-size: 2rem;
		font-weight: 800;
		color: var(--accent-light);
		line-height: 1;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--text-dim);
		margin-top: 4px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.section {
		padding: 80px 24px;
	}

	.section-alt {
		background: var(--bg-card);
		border-top: 1px solid var(--border-subtle);
		border-bottom: 1px solid var(--border-subtle);
	}

	.container {
		max-width: var(--max-w);
		margin: 0 auto;
	}

	.section h2 {
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 8px;
	}

	.section-desc {
		color: var(--text-muted);
		font-size: 1rem;
		margin-bottom: 40px;
		max-width: 600px;
	}

	/* Install */
	.install-steps {
		display: flex;
		flex-direction: column;
		gap: 24px;
		margin-bottom: 32px;
	}

	.install-step {
		display: flex;
		gap: 20px;
		align-items: flex-start;
	}

	.step-num {
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--accent-glow);
		border: 1px solid rgba(99, 102, 241, 0.3);
		color: var(--accent-light);
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 0.875rem;
	}

	.step-content h3 {
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.step-note {
		color: var(--text-dim);
		font-size: 0.85rem;
		margin-top: 8px;
	}

	.install-note {
		padding: 16px 20px;
		background: var(--accent-glow);
		border: 1px solid rgba(99, 102, 241, 0.2);
		border-radius: var(--radius-sm);
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.install-note strong {
		color: var(--text);
	}

	/* Skills */
	.skill-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 16px;
	}

	.skill-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
