---
import Layout from '../layouts/Layout.astro';

const agents = [
	{
		name: "vault",
		description: "Unified Obsidian vault manager. Index, search, organize, verify, create notes, run health checks, and detect broken links — all in one agent with bilingual support (EN/ES).",
		permissions: "read, glob, grep, task, edit",
		type: "agent" as const,
	},
	{
		name: "paper-researcher",
		description: "Produces rigorous academic papers in Markdown (APA/IEEE/Vancouver). Bilingual EN/ES.",
		permissions: "bash, read, glob, grep, webfetch, task, edit",
		type: "agent" as const,
	},
	{
		name: "jobfinder",
		description: "Analyzes professional profile, searches jobs across multiple boards, calculates 5D match scores, generates CVs and cover letters, and tracks applications.",
		permissions: "bash, read, glob, grep, webfetch, task, edit",
		type: "agent" as const,
	},
];

const skills = [
	{
		name: "telegram-notify",
		description: "Full Telegram Bot API client with auto-retry and zero-dep fallback. Sends notifications, alerts, and file uploads.",
		dependencies: [],
		category: "notification",
		type: "first-party" as const,
	},
	{
		name: "research-pipeline",
		description: "Structured quantitative research process for prediction markets and data-driven questions.",
		dependencies: ["telegram-notify"],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "backtest-run",
		description: "Runs backtests for trading strategies with slippage/fill modeling and robustness checks.",
		dependencies: ["telegram-notify"],
		category: "finance",
		type: "first-party" as const,
	},
	{
		name: "backtest-validate",
		description: "5-dimension scoring framework for backtest quality: Sample Size, Expectancy, Risk Management, Robustness, Execution Realism.",
		dependencies: ["backtest-run"],
		category: "finance",
		type: "first-party" as const,
	},
	{
		name: "academic-source-search",
		description: "Searches verified scientific sources across 14 academic databases with quality tier filtering.",
		dependencies: [],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "citation-formatter",
		description: "Complete citation and reference formatting for APA 7th, IEEE, and Vancouver styles.",
		dependencies: [],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "math-notation",
		description: "Math notation rules for inline formulas: italic variables, superscripts, subscripts.",
		dependencies: ["citation-formatter"],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "content-humanizer",
		description: "Final document revision to reduce AI-detectable patterns. Includes local detection verification script.",
		dependencies: [],
		category: "writing",
		type: "first-party" as const,
	},
	{
		name: "osint",
		description: "OSINT investigation framework with 7 reference guides and 5 scripts for person/company/domain research.",
		dependencies: [],
		category: "investigation",
		type: "first-party" as const,
	},
	{
		name: "metric-optimizer",
		description: "Optimizes numerical metrics via autonomous iterative improvement loop. Never asks for input.",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "roadmaps",
		description: "Creates, updates, and follows adaptive roadmaps for any project. Validates structure and detects cycles.",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "project-analyzer",
		description: "Read-only project analysis: structure, code quality, bugs, security, performance, and dependency health with severity levels.",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "agent-self-improver",
		description: "Self-improvement framework for agents: collects feedback, detects patterns, suggests improvements with human supervision.",
		dependencies: [],
		category: "meta",
		type: "first-party" as const,
	},
	{
		name: "skill-creator",
		description: "Meta-skill: create, evaluate, compare, and optimize other skills with benchmarking.",
		dependencies: [],
		category: "meta",
		type: "third-party" as const,
		author: "Anthropic, PBC",
		license: "Apache 2.0",
		repo: "https://github.com/anthropics/claude-code",
	},
	{
		name: "impeccable",
		description: "Frontend design audit, polish, and redesign skill with 23 commands for UI excellence.",
		dependencies: [],
		category: "design",
		type: "third-party" as const,
		author: "pbakaus",
		license: "Apache 2.0",
		repo: "https://github.com/pbakaus/impeccable",
	},
	{
		name: "ai-job-search",
		description: "AI job application framework: 5D fit evaluation, CV tailoring, cover letters, interview prep, and application tracking.",
		dependencies: [],
		category: "career",
		type: "third-party" as const,
		author: "MadsLorentzen",
		license: "MIT",
		repo: "https://github.com/MadsLorentzen/ai-job-search",
	},
];

const commands = [
	{
		skill: "osint",
		scripts: [
			{ cmd: "python skills/osint/scripts/generate_plan.py", desc: "Generate OSINT investigation plan", args: "--target-type person --target-value \"John Doe\" --depth standard" },
			{ cmd: "python skills/osint/scripts/run_investigation.py", desc: "Execute OSINT pipeline from plan", args: "--plan investigation_plan.json --interactive" },
			{ cmd: "python skills/osint/scripts/phone_parser.py", desc: "Parse and normalize phone numbers", args: "+1234567890 --json" },
			{ cmd: "python skills/osint/scripts/scrape_directories.py", desc: "Scrape free public phone directories", args: "+1234567890 --json" },
			{ cmd: "python skills/osint/scripts/gen_report.py", desc: "Generate OSINT investigation report", args: "--target \"John Doe\" --target-type person --format both" },
		],
	},
	{
		skill: "jobfinder",
		scripts: [
			{ cmd: "python skills/jobfinder/scripts/search_jobs.py", desc: "Search jobs across multiple boards", args: "--keywords \"python developer\" --location \"Remote\" --remote-only" },
			{ cmd: "python skills/jobfinder/scripts/score_match.py", desc: "Score jobs against your profile (5D)", args: "--profile profile.json --jobs results.json" },
			{ cmd: "python skills/jobfinder/scripts/gap_analysis.py", desc: "Analyze skill gaps for target roles", args: "--profile profile.json --scored scored.json" },
			{ cmd: "python skills/jobfinder/scripts/generate_cv_pdf.py", desc: "Generate professional CV PDF", args: "--profile profile.json --lang en" },
			{ cmd: "python skills/jobfinder/scripts/generate_cover_letter.py", desc: "Generate tailored cover letter", args: "--profile profile.json --job job.json" },
			{ cmd: "python skills/jobfinder/scripts/suggest_projects.py", desc: "Suggest GitHub projects for skill gaps", args: "--missing-skills \"kubernetes,docker\" --job-title \"SRE\"" },
			{ cmd: "python skills/jobfinder/scripts/track_application.py", desc: "Track job applications", args: "add --company \"Acme\" --role \"Dev\"" },
		],
	},
	{
		skill: "backtest-validate",
		scripts: [
			{ cmd: "python skills/backtest-validate/scripts/evaluate_backtest.py", desc: "Score backtest quality (5D framework)", args: "--total-trades 200 --win-rate 0.58 --avg-win-pct 2.1 --avg-loss-pct 1.5 --max-drawdown-pct 12 --years-tested 3 --num-parameters 8 --slippage-tested" },
		],
	},
	{
		skill: "citation-formatter",
		scripts: [
			{ cmd: "python skills/citation-formatter/scripts/generate_outputs.py", desc: "Generate formatted academic document", args: "--file paper.md --norm apa --html" },
		],
	},
	{
		skill: "content-humanizer",
		scripts: [
			{ cmd: "python skills/content-humanizer/scripts/detect_ai.py", desc: "Detect AI-generated text patterns", args: "--file essay.md --verbose" },
		],
	},
	{
		skill: "roadmaps",
		scripts: [
			{ cmd: "python skills/roadmaps/scripts/validate_roadmap.py", desc: "Validate roadmap structure and detect cycles", args: "--file roadmap.md" },
		],
	},
];

const usageGuides = [
	{
		name: "vault",
		type: "agent" as const,
		triggers: [
			"Find notes about Python",
			"Organize my vault by topic",
			"Create a daily note",
		],
	},
	{
		name: "paper-researcher",
		type: "agent" as const,
		triggers: [
			"Write a research paper on X in APA",
			"Find academic sources for my thesis",
			"Review my paper's citations",
		],
	},
	{
		name: "jobfinder",
		type: "agent" as const,
		triggers: [
			"Find remote Python developer jobs",
			"Score my CV against this posting",
			"Generate a cover letter for this role",
		],
	},
	{
		name: "telegram-notify",
		type: "skill" as const,
		triggers: [
			"Notify me on Telegram when this completes",
			"Send alert to my Telegram chat",
		],
	},
	{
		name: "academic-source-search",
		type: "skill" as const,
		triggers: [
			"Find papers about machine learning",
			"Search arXiv for recent studies",
		],
	},
	{
		name: "citation-formatter",
		type: "skill" as const,
		triggers: [
			"Format my citations in APA 7th",
			"Generate a references section in IEEE",
		],
	},
	{
		name: "content-humanizer",
		type: "skill" as const,
		triggers: [
			"Make this text undetectable by AI",
			"Run AI detection on this essay",
		],
	},
	{
		name: "osint",
		type: "skill" as const,
		triggers: [
			"Run an OSINT investigation on this target",
			"Look up this phone number",
		],
	},
	{
		name: "metric-optimizer",
		type: "skill" as const,
		triggers: [
			"Optimize this metric to 95% accuracy",
			"Maximize model performance",
		],
	},
	{
		name: "roadmaps",
		type: "skill" as const,
		triggers: [
			"Create a plan for this project",
			"Break this feature into steps",
		],
	},
	{
		name: "project-analyzer",
		type: "skill" as const,
		triggers: [
			"Analyze this codebase for issues",
			"Audit this project's security",
		],
	},
	{
		name: "research-pipeline",
		type: "skill" as const,
		triggers: [
			"Research this prediction market question",
			"Test this hypothesis with data",
		],
	},
	{
		name: "backtest-run",
		type: "skill" as const,
		triggers: [
			"Backtest this trading strategy",
			"Run a backtest with slippage",
		],
	},
	{
		name: "backtest-validate",
		type: "skill" as const,
		triggers: [
			"Validate this backtest quality",
			"Score this strategy before deploying",
		],
	},
	{
		name: "math-notation",
		type: "skill" as const,
		triggers: [
			"Auto-applied when writing math in academic docs",
		],
	},
	{
		name: "agent-self-improver",
		type: "skill" as const,
		triggers: [
			"Improve this agent's performance",
			"Review agent patterns and issues",
		],
	},
	{
		name: "skill-creator",
		type: "skill" as const,
		triggers: [
			"Create a new skill from scratch",
			"Optimize this skill's triggers",
		],
	},
	{
		name: "impeccable",
		type: "skill" as const,
		triggers: [
			"Polish this landing page UI",
			"Audit this design for accessibility",
		],
	},
	{
		name: "ai-job-search",
		type: "skill" as const,
		triggers: [
			"Evaluate this job posting fit",
			"Tailor my CV for this role",
		],
	},
];

const categoryColors: Record<string, string> = {
	notification: "var(--green)",
	research: "var(--cyan)",
	finance: "var(--amber)",
	writing: "var(--purple)",
	investigation: "var(--red)",
	automation: "var(--accent)",
	meta: "var(--text-dim)",
	design: "var(--purple)",
	career: "var(--green)",
};
---

<Layout title="Agents & Skills — AI Agent Definitions">
	<nav class="nav">
		<div class="nav-inner">
			<a href="#" class="nav-logo">
				<span class="logo-icon">&#9670;</span>
				Agents-Skills
			</a>
			<div class="nav-links">
				<a href="#install">Install</a>
				<a href="#usage">Usage</a>
				<a href="#skills">Skills</a>
				<a href="#agents">Agents</a>
				<a href="#commands">Commands</a>
				<a href="#third-party">Third-Party</a>
				<a href="https://github.com/soymatta/Agents-Skills" target="_blank">GitHub</a>
			</div>
		</div>
	</nav>

	<header class="hero">
		<div class="hero-badge">Open Source &middot; MIT License</div>
		<h1>AI Agents &amp; Skills</h1>
		<p class="hero-sub">
			A curated collection of agent and skill definitions for
			<strong>OpenCode</strong>, <strong>Claude Code</strong>, <strong>Cursor</strong>,
			and <strong>Windsurf</strong>. Each definition shapes how AI assistants
			approach specific tasks — from vault indexing to backtesting to OSINT investigations.
		</p>
		<div class="hero-actions">
			<a href="#install" class="btn btn-primary">Get Started</a>
			<a href="#skills" class="btn btn-ghost">Browse Skills</a>
		</div>
		<div class="hero-stats">
			<div class="stat">
				<span class="stat-num">{skills.length}</span>
				<span class="stat-label">Skills</span>
			</div>
			<div class="stat">
				<span class="stat-num">{agents.length}</span>
				<span class="stat-label">Agents</span>
			</div>
			<div class="stat">
				<span class="stat-num">{commands.reduce((acc, c) => acc + c.scripts.length, 0)}</span>
				<span class="stat-label">Commands</span>
			</div>
			<div class="stat">
				<span class="stat-num">4</span>
				<span class="stat-label">Platforms</span>
			</div>
		</div>
	</header>

	<section id="install" class="section">
		<div class="container">
			<h2>Installation</h2>
			<p class="section-desc">Clone the repo, install dependencies, and run the interactive installer to toggle which agents and skills you want.</p>

			<div class="install-steps">
				<div class="install-step">
					<div class="step-num">1</div>
					<div class="step-content">
						<h3>Clone &amp; Install</h3>
						<pre><code>git clone https://github.com/soymatta/Agents-Skills.git
cd Agents-Skills
pip install -r skills/requirements.txt</code></pre>
					</div>
				</div>
				<div class="install-step">
					<div class="step-num">2</div>
					<div class="step-content">
						<h3>Run the Installer</h3>
						<pre><code>python setup.py</code></pre>
						<p class="step-note">Interactive TUI — toggle agents/skills with arrow keys and space.</p>
					</div>
				</div>
				<div class="install-step">
					<div class="step-num">3</div>
					<div class="step-content">
						<h3>Or Install Everything</h3>
						<pre><code>python setup.py --all
python setup.py --all --platform opencode --local</code></pre>
						<p class="step-note">Supports: opencode, claude, cursor, windsurf</p>
					</div>
				</div>
			</div>

			<div class="install-note">
				<strong>Requirements:</strong> Python &ge; 3.11 &middot;
				<strong>Environment:</strong> Copy <code>.env.example</code> to <code>.env</code> and set <code>TELEGRAM_BOT_TOKEN</code> + <code>TELEGRAM_CHAT_ID</code> for notification skills.
			</div>
		</div>
	</section>

	<section id="usage" class="section section-alt">
		<div class="container">
			<h2>Quick Usage</h2>
			<p class="section-desc">Talk to agents and skills in natural language. The AI detects your intent and executes the right workflow automatically.</p>

			<div class="usage-grid">
				{usageGuides.map(item => (
					<div class="usage-card">
						<div class="usage-header">
							<h3 class="usage-name">{item.name}</h3>
							<span class={`usage-badge usage-badge-${item.type}`}>{item.type}</span>
						</div>
						<ul class="usage-triggers">
							{item.triggers.map(t => (
								<li><code>{t}</code></li>
							))}
						</ul>
					</div>
				))}
			</div>

			<div class="usage-note">
				<strong>Tip:</strong> Agents and skills activate from natural conversation — no special syntax needed. Just describe what you want.
			</div>
		</div>
	</section>

	<section id="skills" class="section section-alt">
		<div class="container">
			<h2>Skills</h2>
			<p class="section-desc">Specialized instructions and workflows for specific tasks. Each skill is a markdown file with YAML frontmatter that defines triggers, permissions, and procedures.</p>

			<div class="skill-grid">
				{skills.filter(s => s.type === "first-party").map(skill => (
					<div class="skill-card">
						<div class="skill-header">
							<h3 class="skill-name">{skill.name}</h3>
							<span class="skill-badge" style={`--badge-color: ${categoryColors[skill.category]}`}>
								{skill.category}
							</span>
						</div>
						<p class="skill-desc">{skill.description}</p>
						{skill.dependencies.length > 0 && (
							<div class="skill-deps">
								<span class="deps-label">Requires:</span>
								{skill.dependencies.map(dep => (
									<code class="dep-tag">{dep}</code>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="agents" class="section">
		<div class="container">
			<h2>Agents</h2>
			<p class="section-desc">Primary agents with defined permissions that shape how AI assistants behave for specific workflows.</p>

			<div class="agent-grid">
				{agents.map(agent => (
					<div class="agent-card">
						<div class="agent-header">
							<h3 class="agent-name">{agent.name}</h3>
							<span class="agent-badge">agent</span>
						</div>
						<p class="agent-desc">{agent.description}</p>
						<div class="agent-perms">
							<span class="perms-label">Permissions:</span>
							<div class="perm-tags">
								{agent.permissions.split(", ").map(p => (
									<span class="perm-tag">{p}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="commands" class="section section-alt">
		<div class="container">
			<h2>Commands</h2>
			<p class="section-desc">Runnable CLI scripts you can execute directly from the terminal. Each skill may include scripts that work standalone without the AI agent.</p>

			<div class="commands-grid">
				{commands.map(group => (
					<div class="command-group">
						<div class="command-group-header">
							<h3 class="command-skill-name">{group.skill}</h3>
							<span class="command-count">{group.scripts.length} script{group.scripts.length > 1 ? 's' : ''}</span>
						</div>
						<div class="command-list">
							{group.scripts.map(script => (
								<div class="command-item">
									<div class="command-top">
										<span class="command-desc">{script.desc}</span>
									</div>
									<pre class="command-code"><code>{script.cmd} \</code>
<code>  {script.args}</code></pre>
								</div>
							))}
						</div>
					</div>
				))}
			</div>

			<div class="commands-note">
				<strong>Tip:</strong> All scripts accept <code>--help</code> for full usage info. Run from the repo root directory.
			</div>
		</div>
	</section>

	<section id="third-party" class="section">
		<div class="container">
			<h2>Third-Party Skills</h2>
			<p class="section-desc">These skills are authored externally and included with their original licenses. Do not modify them — pull updates from the upstream source.</p>

			<div class="third-party-grid">
				{skills.filter(s => s.type === "third-party").map(skill => (
					<div class="tp-card">
						<div class="tp-header">
							<h3 class="tp-name">{skill.name}</h3>
							<span class="tp-badge">{skill.license}</span>
						</div>
						<p class="tp-desc">{skill.description}</p>
						<div class="tp-meta">
							<span>By <strong>{skill.author}</strong></span>
							<a href={skill.repo} target="_blank" class="tp-link">
								View Source &rarr;
							</a>
						</div>
					</div>
				))}
			</div>

			<div class="tp-rules">
				<h3>Modification Rules</h3>
				<ul>
					<li><code>skill-creator</code> — authored by <strong>Anthropic, PBC</strong> (Apache 2.0). Do not modify. To update, pull from the upstream source.</li>
					<li><code>impeccable</code> — authored by <strong>pbakaus</strong> (Apache 2.0). Do not modify. To update, run <code>npx impeccable install --providers=opencode --scope=project --force</code>.</li>
					<li><code>ai-job-search</code> — authored by <strong>MadsLorentzen</strong> (MIT). Do not modify. To update, pull from the upstream source.</li>
				</ul>
			</div>
		</div>
	</section>

	<section id="testing" class="section">
		<div class="container">
			<h2>Testing</h2>
			<p class="section-desc">Run the full test suite or target a specific skill's tests.</p>

			<div class="test-commands">
				<pre><code># All tests
python -m pytest skills/ -v

# By skill
python -m pytest skills/backtest-validate/tests/ -v
python -m pytest skills/osint/tests/ -v
python -m pytest skills/content-humanizer/tests/ -v
python -m pytest skills/skill-creator/tests/ -v
python -m pytest skills/roadmaps/tests/ -v
python -m pytest skills/jobfinder/tests/ -v
python -m pytest skills/ai-job-search/tests/ -v
python -m pytest skills/agent-self-improver/tests/ -v</code></pre>
			</div>
		</div>
	</section>

	<footer class="footer">
		<div class="container footer-inner">
			<p>Agents &amp; Skills &middot; <a href="https://github.com/soymatta/Agents-Skills">GitHub</a> &middot; MIT License</p>
			<p class="footer-sub">AI agent and skill definitions for OpenCode, Claude Code, Cursor, and Windsurf.</p>
		</div>
	</footer>
</Layout>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 11, 0.8);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border-subtle);
	}

	.nav-inner {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 0 24px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav-logo {
		font-weight: 700;
		font-size: 1rem;
		color: var(--text);
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.logo-icon {
