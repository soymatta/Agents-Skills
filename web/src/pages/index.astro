---
import Layout from '../layouts/Layout.astro';

const agents = [
	{
		name: "reverse-engineer",
		description: "Reverse-engineering orchestrator for software you own or are authorized to analyze. Gates on authorization, classifies the target, and delegates to the right toolchain (apk-reverse skill for APKs, rea MCP for native/.NET/Electron/Flutter/firmware) instead of reinventing it. Bilingual EN/ES.",
		permissions: "edit, bash, read, glob, grep, list, webfetch, websearch, task, question",
		type: "agent" as const,
	},
	{
		name: "vault",
		description: "Unified notes manager for Obsidian, OneNote, Notion, and any markdown-based app. Index, search, organize, verify, create notes, run health checks, and detect broken links — all in one agent with bilingual support (EN/ES).",
		permissions: "read, glob, grep, task, edit",
		type: "agent" as const,
	},
	{
		name: "paper-researcher",
		description: "Produces rigorous academic papers in Markdown (APA/IEEE/Vancouver). Bilingual EN/ES.",
		permissions: "bash, read, glob, grep, webfetch, task, edit",
		type: "agent" as const,
	},
	{
		name: "jobfinder",
		description: "Analyzes professional profile, searches jobs across multiple boards, calculates 5D match scores, generates CVs and cover letters, and tracks applications.",
		permissions: "bash, read, glob, grep, webfetch, task, edit",
		type: "agent" as const,
	},
	{
		name: "builder",
		description: "Default full-access build agent. Reads, writes, edits files, runs commands, and executes all available tools. Combines the build role with self-improvement, skill creation, skill improvement, goal optimization, and roadmap tracking.",
		permissions: "* allow (question; doom_loop ask)",
		type: "agent" as const,
	},
	{
		name: "fitness-coach",
		description: "Science-based fitness coach. Answers hypertrophy, strength, and conditioning questions from Tier 1-2 peer-reviewed evidence (meta-analyses, systematic reviews, RCTs); delegates search to academic-source-search and citations to citation-formatter. No code, no bro-science.",
		permissions: "read, glob, grep, webfetch, websearch, task",
		type: "agent" as const,
	},
];

const skills = [
	{
		name: "commit",
		description: "Creates git commits in this repo's house convention ({Type}: {explanation}), with a commit-msg validator wired into a husky hook (native git hook fallback). Never branches, never opens PRs.",
		usage: "Commit this",
		dependencies: [],
		category: "development",
		type: "first-party" as const,
	},
	{
		name: "ui-ux-orchestrator",
		description: "Routes one frontend request to the right UI/UX skill (design system from zero, craft/refine, guidelines review, launch checklist, runtime QA), fixes the order and precedence so the skills never contradict each other, and merges the executable checks into one prioritized report.",
		usage: "Orchestrate which UI/UX skills to run for this page",
		dependencies: ["ui-ux-pro-max", "impeccable", "web-design-guidelines", "web-esenciales"],
		category: "design",
		type: "first-party" as const,
	},
	{
		name: "web-design-guidelines",
		description: "Third-party (Vercel): reviews UI code for compliance with the Web Interface Guidelines — accessibility, interaction, and layout best practices.",
		usage: "Review my UI against the Web Interface Guidelines",
		dependencies: [],
		category: "web",
		type: "third-party" as const,
	},
	{
		name: "telegram-notify",
		description: "Full Telegram Bot API client (sends text, photos, documents, media groups; webhooks, polling) with auto-retry and exponential backoff. Never blocks execution on failures.",
		usage: "Notify me on Telegram when this completes",
		dependencies: ["requests"],
		category: "notification",
		type: "first-party" as const,
	},
	{
		name: "research-pipeline",
		description: "Structured quantitative research process for prediction markets and data-driven questions.",
		usage: "Research this prediction market question",
		dependencies: ["telegram-notify"],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "backtest-run",
		description: "Runs backtests for trading strategies with slippage/fill modeling and robustness checks.",
		usage: "Backtest this trading strategy",
		dependencies: ["telegram-notify"],
		category: "finance",
		type: "first-party" as const,
	},
	{
		name: "backtest-validate",
		description: "5-dimension scoring framework for backtest quality: Sample Size, Expectancy, Risk Management, Robustness, Execution Realism.",
		usage: "Validate this backtest quality",
		dependencies: ["backtest-run"],
		category: "finance",
		type: "first-party" as const,
	},
	{
		name: "academic-source-search",
		description: "Searches verified scientific sources across 14 academic databases with quality tier filtering.",
		usage: "Find papers about machine learning",
		dependencies: [],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "citation-formatter",
		description: "Complete citation and reference formatting for APA 7th, IEEE, and Vancouver styles.",
		usage: "Format my citations in APA 7th",
		dependencies: [],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "math-notation",
		description: "Math notation rules for inline formulas: italic variables, superscripts, subscripts.",
		usage: "Auto-applied when writing math in academic docs",
		dependencies: ["citation-formatter"],
		category: "research",
		type: "first-party" as const,
	},
	{
		name: "content-humanizer",
		description: "Final document revision to reduce AI-detectable patterns. Includes local detection verification script.",
		usage: "Make this text undetectable by AI",
		dependencies: [],
		category: "writing",
		type: "first-party" as const,
	},
	{
		name: "osint",
		description: "OSINT investigation framework with 7 reference guides and 5 scripts for person/company/domain research.",
		usage: "Run an OSINT investigation on this target",
		dependencies: [],
		category: "investigation",
		type: "first-party" as const,
	},
	{
		name: "goal",
		description: "Iterative autonomous loop that drives a flow until a measurable objective is reached. Handles maximize/minimize/exact targets, persists progress, reverts on degradation, stops on budget.",
		usage: "Alcanza este objetivo / Optimize this metric to 95% accuracy",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "roadmaps",
		description: "Creates, updates, and follows adaptive roadmaps for any project. Validates structure and detects cycles.",
		usage: "Create a plan for this project",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "project-analyzer",
		description: "Read-only project analysis: structure, code quality, bugs, security, performance, and dependency health with severity levels.",
		usage: "Analyze this codebase for issues",
		dependencies: [],
		category: "automation",
		type: "first-party" as const,
	},
	{
		name: "agent-self-improver",
		description: "Self-improvement framework for agents: collects feedback, detects patterns, suggests improvements with human supervision.",
		usage: "Improve this agent's performance",
		dependencies: [],
		category: "meta",
		type: "first-party" as const,
	},
	{
		name: "code-review",
		description: "Reviews a diff read-only on three axes (code quality, feature behavior vs. plan, relevancy) into one verdict report before shipping.",
		usage: "Review this diff",
		dependencies: [],
		category: "development",
		type: "first-party" as const,
	},
	{
		name: "refactor",
		description: "Improves code across four axes (cleanup, performance, security, architecture) by scanning and fixing, or applying audit findings. Behavior-preserving except security. Includes a 20-point web launch checklist (SEO, canonical URLs, SSL, backups, conversions).",
		usage: "Refactor this module for performance",
		dependencies: [],
		category: "development",
		type: "first-party" as const,
	},
	{
		name: "debug",
		description: "Reproduces and fixes known bugs, or finds unknown root causes by hypothesis validation, with a test-driven fix and regression test.",
		usage: "Debug why this breaks",
		dependencies: [],
		category: "development",
		type: "first-party" as const,
	},
	{
		name: "git-workflow",
		description: "Version-control workflows: atomic conventional commits, branches, pull/merge requests, and release tags.",
		usage: "Commit these changes",
		dependencies: [],
		category: "development",
		type: "first-party" as const,
	},
	{
		name: "project-memory",
		description: "Builds and maintains the project's durable memory of architecture, conventions, and decisions so every session starts grounded.",
		usage: "Set up project memory",
		dependencies: [],
		category: "development",
		type: "first-party" as const,
	},
	{
		name: "skill-creator",
		description: "Meta-skill: create, evaluate, compare, and optimize other skills with benchmarking.",
		usage: "Create a new skill from scratch",
		dependencies: [],
		category: "meta",
		type: "third-party" as const,
		author: "Anthropic, PBC",
		license: "Apache 2.0",
		repo: "https://github.com/anthropics/claude-code",
	},
	{
		name: "impeccable",
		description: "Frontend design audit, polish, and redesign skill with 23 commands for UI excellence.",
		usage: "/init, /shape, /critique, /polish, /audit",
		dependencies: [],
		category: "design",
		type: "third-party" as const,
		author: "pbakaus",
		license: "Apache 2.0",
		repo: "https://github.com/pbakaus/impeccable",
	},
	{
		name: "ai-job-search",
		description: "AI job application framework: 5D fit evaluation, CV tailoring, cover letters, interview prep, and application tracking.",
		usage: "/setup, /apply, /scrape, /rank, /interview",
		dependencies: [],
		category: "career",
		type: "third-party" as const,
		author: "MadsLorentzen",
		license: "MIT",
		repo: "https://github.com/MadsLorentzen/ai-job-search",
	},
	{
		name: "qa-tester",
		description: "Multiplatform QA suite: functional regression, exhaustive exploration, break-to-fix loop, multi-user, performance, security, and device compatibility. Uses Playwright codegen only as exploration scaffolding.",
		usage: "Test this app / Intenta romper la app",
		dependencies: [],
		category: "testing",
		type: "first-party" as const,
	},
	{
		name: "web-cloner",
		description: "Clones pages and full sites into organized local code with stack detection and port to Astro, React, Vue, or Svelte.",
		usage: "Clone this website / Descarga esta pagina",
		dependencies: [],
		category: "web",
		type: "first-party" as const,
	},
	{
		name: "web-esenciales",
		description: "Audits and completes the 20 must-haves of a business website; asks before implementing each gap.",
		usage: "Mejora mi web / Is my site ready",
		dependencies: [],
		category: "web",
		type: "first-party" as const,
	},
	{
		name: "jobfinder",
		description: "Scripted job search: 5-dimension fit scoring, tailored CVs, cover letters, and application tracking. For guided back-and-forth use the jobfinder agent.",
		usage: "Find jobs for this profile / Score my CV",
		dependencies: [],
		category: "career",
		type: "first-party" as const,
	},
	{
		name: "ui-ux-pro-max",
		description: "Generates complete design systems (pattern, style, colors, typography) with 79 styles and 192 per-industry rules.",
		usage: "Build a landing page for my SaaS / Mejora el diseno de mi app",
		dependencies: [],
		category: "design",
		type: "third-party" as const,
		author: "nextlevelbuilder",
		repo: "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill",
	},
];

const plugins = [
	{
		name: "opencode-auto-session",
		description: "OpenCode-only plugin: writes a session dump when a free-tier/provider limit hits (429/402) or on demand with /autosession dump, injects the repo's previous session context into new sessions, and warns (or, opt-in, recovers) on the limit. One dump file per session, pruned.",
		usage: "Runs automatically. Slash commands: /autosession status | dump | files | inject | simulate | reset.",
		target: "opencode",
		type: "first-party" as const,
	},
	{
		name: "opencode-tui-queue",
		description: "OpenCode-only plugin: queues prompts written while the assistant is busy and flushes them one by one, so nothing typed mid-turn is lost.",
		usage: "Runs automatically. Slash command: /queue <text>.",
		target: "opencode",
		type: "first-party" as const,
	},
	{
		name: "opencode-telegram-answers",
		description: "OpenCode-only plugin: notifies Telegram when the AI finishes a task (session.idle) or requests a tool permission (permission.asked/updated). Text-only, markdown->HTML, debounced.",
		usage: "Runs automatically — no prompt needed. Installed via the repo installer or install.ps1.",
		target: "opencode",
		type: "first-party" as const,
	},
];

const aiCommands = [
	{
		skill: "impeccable",
		commands: [
			{ cmd: "/init", desc: "Capture product context in PRODUCT.md" },
			{ cmd: "/shape [feature]", desc: "Plan UX/UI before writing code" },
			{ cmd: "/critique [target]", desc: "UX design review with heuristic scoring" },
			{ cmd: "/audit [target]", desc: "Technical quality checks (a11y, perf, responsive)" },
			{ cmd: "/polish [target]", desc: "Final quality pass before shipping" },
			{ cmd: "/bolder [target]", desc: "Amplify safe or bland designs" },
			{ cmd: "/harden [target]", desc: "Production-ready: errors, i18n, edge cases" },
			{ cmd: "/animate [target]", desc: "Add purposeful animations and motion" },
			{ cmd: "/layout [target]", desc: "Fix spacing, rhythm, and visual hierarchy" },
			{ cmd: "/document", desc: "Generate DESIGN.md from existing code" },
			{ cmd: "/live", desc: "Visual variant mode in the browser" },
		],
	},
	{
		skill: "ai-job-search",
		commands: [
			{ cmd: "/setup", desc: "Onboarding: fill in candidate profile" },
			{ cmd: "/apply <url>", desc: "Full workflow: evaluate fit, draft CV + cover letter" },
			{ cmd: "/scrape", desc: "Search multiple job portals with fit ratings" },
			{ cmd: "/rank", desc: "Batch-score scraped jobs into ranked shortlist" },
			{ cmd: "/interview", desc: "Stage-specific interview prep + mock interview" },
			{ cmd: "/upskill", desc: "Skill gap analysis with learning plans" },
		],
	},
	{
		skill: "project-analyzer",
		commands: [
			{ cmd: "/init-review [scope]", desc: "Project onboarding + health scan, shown on screen, then offers guided fixes (all / critical / structure / code / none) via the builder agent" },
		],
	},
];

const categoryColors: Record<string, string> = {
	notification: "var(--green)",
	research: "var(--cyan)",
	finance: "var(--amber)",
	writing: "var(--purple)",
	investigation: "var(--red)",
	automation: "var(--accent)",
	meta: "var(--text-dim)",
	design: "var(--purple)",
	career: "var(--green)",
	development: "var(--orange)",
};

const firstPartySkills = skills.filter(s => s.type === "first-party");

const skillGroups = [...new Set(firstPartySkills.map(s => s.category))]
	.map(category => ({
		category,
		color: categoryColors[category],
		items: firstPartySkills.filter(s => s.category === category),
	}))
	.sort((a, b) => b.items.length - a.items.length);

// Big categories hold the full-width list; the one- and two-item categories
// pair up beside each other so six labels do not cost six empty screens.
const majorGroups = skillGroups.filter(g => g.items.length >= 3);
const minorGroups = skillGroups.filter(g => g.items.length < 3);

const tally = [
	{ num: skills.length, label: "skills" },
	{ num: agents.length, label: "agents" },
	{ num: aiCommands.reduce((acc, c) => acc + c.commands.length, 0), label: "commands" },
	{ num: plugins.length, label: "plugins" },
	{ num: 4, label: "platforms" },
];

// Real excerpt from skills/commit/SKILL.md — the hero shows what a definition is.
const artifactSnippet = `---
name: commit
description: Creates git commits in this repository's house
  convention: a capitalized conventional type plus a short
  English explanation.
---

1. Inspect git status, diff and log.
2. Stage only the intended files.
3. Commit: {Type}: {explanation}`;
---

<Layout title="Agents & Skills — AI Agent Definitions">
	<nav class="nav" aria-label="Primary">
		<div class="nav-inner">
			<a href="/" class="nav-logo">
				<span class="logo-icon" aria-hidden="true">&#9670;</span>
				Agents-Skills
			</a>
			<div class="nav-links">
				<a href="#install">Install</a>
				<a href="#skills">Skills</a>
				<a href="#agents">Agents</a>
				<a href="#commands">Commands</a>
				<a href="#plugins">Plugins</a>
				<a href="#third-party">Third-Party</a>
			</div>
			<a class="nav-cta" href="https://github.com/soymatta/Agents-Skills" target="_blank" rel="noopener noreferrer">GitHub</a>
		</div>
	</nav>

	<main id="main">
	<header class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<h1>AI Agents &amp; Skills</h1>
				<p class="hero-sub">
					A curated collection of agent and skill definitions for <strong>OpenCode</strong>, <strong>Claude Code</strong>, <strong>Cursor</strong>, and <strong>Windsurf</strong>. Each definition shapes how AI assistants approach specific tasks — from vault indexing to backtesting to OSINT investigations.
				</p>
				<div class="hero-actions">
					<a href="#install" class="btn btn-primary">Get Started</a>
					<a href="#skills" class="btn btn-ghost">Browse Skills</a>
				</div>
			</div>
			<aside class="artifact" aria-label="Example skill definition">
				<div class="artifact-bar">
					<span class="artifact-path">skills/commit/SKILL.md</span>
					<span class="artifact-chip">MIT</span>
				</div>
				<pre class="artifact-body"><code>{artifactSnippet}</code></pre>
			</aside>
		</div>
		<div class="container">
			<ul class="tally">
				{tally.map(item => (
					<li>
						<span class="tally-num">{item.num}</span>
						<span class="tally-label">{item.label}</span>
					</li>
				))}
			</ul>
		</div>
	</header>

	<section id="install" class="section">
		<div class="container">
			<div class="section-head">
				<h2>Installation</h2>
				<p class="section-desc">Clone the repo, install dependencies, and run the interactive installer to toggle which agents and skills you want.</p>
			</div>

			<div class="install-grid">
				<div class="install-steps">
					<div class="install-step">
						<div class="step-num">1</div>
						<div class="step-content">
							<h3>Clone &amp; Install</h3>
							<pre><code>git clone https://github.com/soymatta/Agents-Skills.git
cd Agents-Skills
pip install -r skills/requirements.txt</code></pre>
						</div>
					</div>
					<div class="install-step">
						<div class="step-num">2</div>
						<div class="step-content">
							<h3>Run the Installer</h3>
							<pre><code>python setup.py</code></pre>
							<p class="step-note">Interactive TUI — toggle agents/skills with arrow keys and space.</p>
						</div>
					</div>
					<div class="install-step">
						<div class="step-num">3</div>
						<div class="step-content">
							<h3>Or Install Everything</h3>
							<pre><code>python setup.py --all
python setup.py --all --platform opencode --local</code></pre>
						</div>
					</div>
				</div>

				<aside class="install-aside">
					<div class="aside-block">
						<h3 class="aside-title">Requirements</h3>
						<div class="chip-row">
							<span class="chip">Python &ge; 3.11</span>
							<span class="chip">pip</span>
							<span class="chip">git</span>
						</div>
					</div>
					<div class="aside-block">
						<h3 class="aside-title">Platforms</h3>
						<div class="chip-row">
							<span class="chip">opencode</span>
							<span class="chip">claude</span>
							<span class="chip">cursor</span>
							<span class="chip">windsurf</span>
						</div>
					</div>
					<div class="aside-block">
						<h3 class="aside-title">Notifications</h3>
						<p>Copy <code>.env.example</code> to <code>.env</code> and set <code>TELEGRAM_BOT_TOKEN</code> + <code>TELEGRAM_CHAT_ID</code> for notification skills.</p>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<section id="skills" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<h2>Skills</h2>
				<p class="section-desc">Specialized instructions and workflows for specific tasks. Each skill is a markdown file with YAML frontmatter that defines triggers, permissions, and procedures.</p>
			</div>

			<div class="catalog">
				{[...majorGroups, ...minorGroups].map(group => (
					<div class={`group${group.items.length >= 3 ? " group-wide" : ""}`}>
						<div class="group-head">
							<span class="dot" style={`background: ${group.color}`} aria-hidden="true"></span>
							<span class="group-label">{group.category}</span>
							<span class="group-count">{group.items.length}</span>
						</div>
						<ul class="items">
							{group.items.map(skill => (
								<li class="item">
									<div class="item-head">
										<code class="item-name">{skill.name}</code>
										<span class="chip-accent">{skill.usage}</span>
									</div>
									<p class="item-desc">{skill.description}</p>
									{skill.dependencies.length > 0 && (
										<p class="item-tail">
											<span class="tail-label">requires</span>
											{skill.dependencies.map(dep => (
												<span class="dep">{dep}</span>
											))}
										</p>
									)}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="agents" class="section">
		<div class="container">
			<div class="section-head">
				<h2>Agents</h2>
				<p class="section-desc">Primary agents with defined permissions that shape how AI assistants behave for specific workflows.</p>
			</div>

			<ul class="items">
				{agents.map(agent => (
					<li class="item">
						<div class="item-head">
							<code class="item-name">{agent.name}</code>
						</div>
						<p class="item-desc">{agent.description}</p>
						<p class="item-tail">
							<span class="tail-label">permissions</span>
							{agent.permissions.split(", ").map(p => (
								<span class="dep">{p}</span>
							))}
						</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section id="commands" class="section section-alt">
		<div class="container">
			<div class="section-head">
				<h2>Commands</h2>
				<p class="section-desc">Slash commands you can type directly in your AI assistant. Some skills expose explicit commands for common workflows.</p>
			</div>

			{aiCommands.map(group => (
				<div class="group">
					<div class="group-head">
						<span class="group-label">{group.skill}</span>
						<span class="group-count">{group.commands.length} command{group.commands.length > 1 ? 's' : ''}</span>
					</div>
					<ul class="items">
						{group.commands.map(cmd => (
							<li class="item item-cmd">
								<code class="item-name cmd-name">{cmd.cmd}</code>
								<p class="cmd-desc">{cmd.desc}</p>
							</li>
						))}
					</ul>
				</div>
			))}

			<div class="tp-rules note">
				<h3>Note</h3>
				<p>Most skills activate from natural language — no commands needed. Only skills with explicit slash commands are listed here.</p>
			</div>
		</div>
	</section>

	<section id="plugins" class="section">
		<div class="container">
			<div class="section-head">
				<h2>Plugins</h2>
